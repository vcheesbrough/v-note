# CI-only: Android devDebug APK + unit tests (Woodpecker build-android).
FROM mingc/android-build-box:master@sha256:6644d9869eeecf26bc80894d00540483139f52f4aa8668c9f4ee873c82dd054c
WORKDIR /workspace
COPY . .
RUN ./scripts/sync-version.sh \
    && cd android \
    && chmod +x ./gradlew \
    && ./gradlew --no-daemon --console=plain -Pandroid.sdk.dir=/opt/android-sdk \
        :app:assembleDevDebug :app:testDevDebugUnitTest
