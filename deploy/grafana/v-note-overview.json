      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(v_note_realtime_replay_bytes_bucket{env=\"$env\"}[$__rate_interval])))",
