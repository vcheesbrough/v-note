{
  "name": "v-note",
  "interval": "1m",
  "rules": [
    {
      "for": "15m",
      "keep_firing_for": "0s",
      "labels": {
        "severity": "warning",
        "service": "v-note"
      },
      "annotations": {
        "summary": "v-note client telemetry ingest volume is unexpectedly high in {{ $labels.deployment_environment }}",
        "description": "The otlp-collector-oidc ingest (#439) has accepted more than 50 spans and log records per second, sustained. It is a public path: an unexpected rise is someone (a runaway client build, or an abuser with a valid token) spending the store. Check the dashboard's Client telemetry row for which signal and whether refusals rose too; the emergency stop is stopping the environment's ingest container, which clients tolerate by design.",
        "runbook_url": "https://github.com/vcheesbrough/otlp-collector-oidc/blob/main/docs/runbook.md#ingest-volume"
      },
      "grafana_alert": {
        "uid": "v-note-client-ingest-volume",
        "title": "VNoteClientTelemetryIngestVolume",
        "condition": "C",
        "no_data_state": "OK",
        "exec_err_state": "Error",
        "missing_series_evals_to_resolve": 2,
        "data": [
          {
            "refId": "A",
            "relativeTimeRange": {
              "from": 600,
              "to": 0
            },
            "datasourceUid": "PBFA97CFB590B2093",
            "model": {
              "refId": "A",
              "expr": "sum by (deployment_environment) (label_replace(rate(otelcol_receiver_accepted_spans{service_name=\"v-note-otlp-collector-oidc\", deployment_environment=\"dev\"}[10m]), \"signal\", \"spans\", \"\", \"\") or label_replace(rate(otelcol_receiver_accepted_log_records{service_name=\"v-note-otlp-collector-oidc\", deployment_environment=\"dev\"}[10m]), \"signal\", \"log_records\", \"\", \"\"))",
              "instant": true
            }
          },
          {
            "refId": "C",
            "relativeTimeRange": {
              "from": 0,
              "to": 0
            },
            "datasourceUid": "__expr__",
            "model": {
              "refId": "C",
              "type": "threshold",
              "expression": "A",
              "conditions": [
                {
                  "evaluator": {
                    "type": "gt",
                    "params": [
                      50
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
