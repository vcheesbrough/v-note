# Paired with Dockerfile.web (auto-selected by BuildKit). See docs/DEPLOY.md.

# Build artifacts
target/
frontend/dist/
frontend/pkg/
frontend/target/

# Android (not used by web image)
android/

# CI / deploy / docs
docs/
deploy/
e2e/
.woodpecker/
authentik/

# Contract tests/schemas (not compiled in release server build)
contracts/
schemas/
crates/server/tests/

# Dockerfiles (avoid COPY . . cache bust on Dockerfile-only edits)
Dockerfile
Dockerfile.*

# Scripts — only the git-credential helper is sourced by the cargo layers.
# Exclude contents (glob, not the dir, so the negation below is honoured) then
# re-include the one file the build needs.
scripts/*
!scripts/docker-git-credential.sh

# Meta
README.md
AGENTS.md
LICENSE
LICENSE-TIER.md
justfile
.gitignore
version.txt

# Git / IDE
.git/
.idea/
.vscode/
.cursor/
