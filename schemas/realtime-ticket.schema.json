{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v-note/schemas/realtime-ticket.schema.json",
  "title": "RealtimeTicketResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticket", "expires_at"],
  "properties": {
    "ticket": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
