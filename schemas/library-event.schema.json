{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v-note/schemas/library-event.schema.json",
  "title": "LibraryEvent",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "page"],
      "properties": {
        "type": {
          "const": "page-created"
        },
        "page": {
          "$ref": "page.schema.json"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "page_id"],
      "properties": {
        "type": {
          "const": "page-deleted"
        },
        "page_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "page_id", "thumbnail"],
      "properties": {
        "type": { "const": "page-thumbnail-updated" },
        "page_id": { "type": "string", "minLength": 1 },
        "thumbnail": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "empty" } } },
            { "type": "object", "additionalProperties": false, "required": ["status", "source_seq"], "properties": { "status": { "enum": ["generating", "failed"] }, "source_seq": { "type": "integer", "minimum": 1 } } },
            { "type": "object", "additionalProperties": false, "required": ["status", "source_seq", "url"], "properties": { "status": { "const": "available" }, "source_seq": { "type": "integer", "minimum": 1 }, "url": { "type": "string", "minLength": 1 } } }
          ]
        }
      }
    }
  ]
}
