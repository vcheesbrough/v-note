# CI-only: Android devDebug APK + unit tests (Woodpecker build-android).
# Base image pin: scripts/android-build-box-image.ref (override via --build-arg in CI).
ARG ANDROID_BUILD_BOX_IMAGE=mingc/android-build-box:master@sha256:6644d9869eeecf26bc80894d00540483139f52f4aa8668c9f4ee873c82dd054c
FROM ${ANDROID_BUILD_BOX_IMAGE}

WORKDIR /workspace
COPY . .
RUN ./scripts/sync-version.sh \
    && cd android \
    && chmod +x ./gradlew \
    && ./gradlew --no-daemon --console=plain -Pandroid.sdk.dir=/opt/android-sdk \
        :app:assembleDevDebug :app:testDevDebugUnitTest
