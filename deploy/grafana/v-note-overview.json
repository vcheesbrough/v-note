{
  "uid": "v-note-overview",
  "title": "v-note — overview",
  "description": "v-note realtime WebSocket, HTTP and thumbnail metrics, filtered by env. Source of truth: deploy/grafana/v-note-overview.json in the v-note repo, published by the publish-grafana-dashboard step on every push that deploys dev, from any branch (the last push wins; the version message names the branch). Edits made in the Grafana UI are overwritten by the next publish unless exported back into the repo.",
  "tags": [
    "v-note",
    "realtime"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 41,
  "links": [
    {
      "title": "Tempo: v-note traces for this env",
      "type": "link",
      "icon": "external link",
      "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22t%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7Bresource.service.name%3D%5C%22v-note%5C%22%20%26%26%20resource.deployment.environment%3D%5C%22${env}%5C%22%7D%22%2C%22limit%22%3A20%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D",
      "targetBlank": true,
      "keepTime": false,
      "includeVars": false,
      "tooltip": "TraceQL search in Explore. Every inbound page message is its own trace; page and session ids are span fields there, never metric labels."
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "definition": "label_values(v_note_realtime_active_connections, env)",
        "query": {
          "qryType": 1,
          "query": "label_values(v_note_realtime_active_connections, env)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "dev",
          "value": "dev"
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Realtime — frames sent",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Page channel frame size p50 / p95 by message type",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "histogram_quantile(0.5, sum by (le, message_type) (rate(v_note_realtime_message_bytes_bucket{env=\"$env\", channel=\"page\"}[$__rate_interval])))",
          "legendFormat": "{{message_type}} p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "histogram_quantile(0.95, sum by (le, message_type) (rate(v_note_realtime_message_bytes_bucket{env=\"$env\", channel=\"page\"}[$__rate_interval])))",
          "legendFormat": "{{message_type}} p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Serialized size of each page-channel frame the server sent, by the frame's serde `type` tag. Quantiles are interpolated within buckets (128 B … 8 MiB, x4 steps)."
    },
