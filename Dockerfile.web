# syntax=docker/dockerfile:1.7

# Runtime base, declared once. The `FROM` below and the OCI `base.*` labels are
# both derived from these args, so they cannot end up describing different
# images — previously the digest was restated in compose, CI and the docs.
ARG BASE_IMAGE_NAME=debian:trixie-slim
ARG BASE_IMAGE_DIGEST=sha256:b6e2a152f22a40ff69d92cb397223c906017e1391a73c952b588e51af8883bf8

# Rust toolchain pin. Three places hold this version and must move together:
# here, `.woodpecker/build.yml` (contract-validation image), and `rust-toolchain.toml`
# (host dev). rust-toolchain.toml is dockerignored so rustup does not re-resolve
# inside the build — this image already *is* the pinned toolchain.
FROM rust:1.98.1@sha256:462a9af3c54fb4718850d3c602fc0e54452c20b1c12a4e4080fdb001d4b9acbf AS builder
# `--locked` is load-bearing: an unlocked resolution of trunk 0.21.14 no longer
# compiles (lightningcss pulls cssparser 0.33 and 0.37 into one graph). 0.21.14 is
# the newest *stable* trunk; 0.22 has only ever shipped betas.
RUN rustup target add wasm32-unknown-unknown \
    && cargo install trunk --version 0.21.14 --locked
WORKDIR /app
# CI passes the computed release tag so the SPA version watermark matches the
# deployed image + /api/meta; read at compile time via option_env! in the frontend.
# Keep ENV before `COPY . .`: cargo does NOT track option_env! for rebuilds, so a
# changed tag must bust this layer (and the trunk build below) to avoid baking a
# stale version. Do not move the cache boundary below the build.
ARG V_NOTE_RELEASE=
ENV V_NOTE_RELEASE=${V_NOTE_RELEASE}
# sovereign-config-provider is a git+tag dep on a PRIVATE repo, so the cargo layers
# need a credential. Use the git CLI so it honours the GIT_CONFIG_* rewrite exported
# from the build secret (env-only — the token is never written to a layer).
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
COPY . .
RUN --mount=type=cache,id=v-note-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=v-note-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=v-note-cargo-target,target=/app/target \
    --mount=type=cache,id=v-note-trunk-cache,target=/root/.cache/trunk \
    --mount=type=secret,id=github_token \
    set -eu; \
    . /app/scripts/docker-git-credential.sh; \
    cd frontend && trunk build --release
RUN --mount=type=cache,id=v-note-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=v-note-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=v-note-cargo-target,target=/app/target \
    --mount=type=secret,id=github_token \
    set -eu; \
    . /app/scripts/docker-git-credential.sh; \
    cargo build --release -p server \
    && cp /app/target/release/server /tmp/server

FROM ${BASE_IMAGE_NAME}@${BASE_IMAGE_DIGEST}

# curl is here for one reason: it is the HEALTHCHECK probe below. The base image
# ships no HTTP client, and `--no-install-recommends` keeps it to libcurl and its
# transitive libraries rather than the suggested tooling around it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl openssl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /tmp/server ./server
COPY --from=builder /app/frontend/dist ./dist
RUN openssl req -x509 -newkey rsa:4096 \
        -keyout /app/key.pem \
        -out /app/cert.pem \
        -days 3650 \
        -nodes \
        -subj "/CN=v-note"
# Image-internal serving config, supplied through the config system's env-override
# layer (the `server` group is never sourced from sovereign-config). Kebab-case leaf
# segments match every other group; `__` separates path segments.
ENV VNOTE__SERVER__TLS-CERT=/app/cert.pem
ENV VNOTE__SERVER__TLS-KEY=/app/key.pem
ENV VNOTE__SERVER__STATIC-DIR=/app/dist
EXPOSE 443
# The single definition of "this container is up", owned by the image so every
# consumer inherits it: the deploy gate (scripts/deploy-v-note.sh polls this
# status rather than running its own probe), the e2e stack's `service_healthy`
# conditions, and a bare `docker run`.
#
# -k, not --cacert: the cert above is self-signed (CN=v-note) and this request
# never leaves loopback. Pinning /app/cert.pem would verify for real but break
# the moment VNOTE__SERVER__TLS-CERT points somewhere else.
# -sS, not -s: curl's error text is what lands in .State.Health.Log, which is the
# first thing anyone reads when a deploy fails the gate.
# `|| exit 1` normalises curl's exit codes — docker reserves 2, curl uses it.
#
# interval=30s deliberately, not 10s: every probe is a real request, so it emits
# a request log line and increments v_note_http_requests_total{route="/health"}
# (crates/server/src/observability.rs). At 10s that is ~8.6k lines/day/container
# of pure noise. start-interval keeps startup detection at ~1s despite the slow
# steady-state interval; a pre-25 daemon ignores it and falls back to interval,
# which costs startup latency but nothing else. The e2e stack overrides these
# timings (e2e/docker-compose.test.yml) so its gate does not inherit the
# production-tuned interval.
#
# start-period=60s is deliberately generous because the deploy gate treats
# `unhealthy` as *terminal*: it must mean "broken", never "started slower than we
# guessed". Nothing is lost by waiting — a process that dies on bad config is
# caught by its run state, not by this probe.
HEALTHCHECK --interval=30s --start-interval=1s --timeout=3s --start-period=60s --retries=3 \
    CMD curl -fsS -k --max-time 3 https://127.0.0.1:443/health || exit 1
CMD ["./server"]

# OCI image metadata, owned here so every build path (CI, `just run-compose`, a
# bare `docker build`) produces the same label set. Only the three per-build
# values are passed in; keeping this block last means changing them rebuilds one
# metadata layer and nothing else.
ARG BASE_IMAGE_NAME
ARG BASE_IMAGE_DIGEST
ARG OCI_IMAGE_VERSION=
ARG OCI_IMAGE_REVISION=
ARG OCI_IMAGE_CREATED=
LABEL org.opencontainers.image.title="v-note" \
      org.opencontainers.image.description="v-note server (Axum API + Leptos SPA static)" \
      org.opencontainers.image.licenses="PolyForm-Noncommercial-1.0.0" \
      org.opencontainers.image.url="https://github.com/vcheesbrough/v-note" \
      org.opencontainers.image.source="https://github.com/vcheesbrough/v-note" \
      org.opencontainers.image.authors="Vincent Cheesbrough" \
      org.opencontainers.image.vendor="Vincent Cheesbrough" \
      org.opencontainers.image.documentation="https://github.com/vcheesbrough/v-note/blob/master/docs/DEPLOY.md" \
      org.opencontainers.image.base.name="${BASE_IMAGE_NAME}" \
      org.opencontainers.image.base.digest="${BASE_IMAGE_DIGEST}" \
      org.opencontainers.image.version="${OCI_IMAGE_VERSION}" \
      org.opencontainers.image.revision="${OCI_IMAGE_REVISION}" \
      org.opencontainers.image.created="${OCI_IMAGE_CREATED}"
