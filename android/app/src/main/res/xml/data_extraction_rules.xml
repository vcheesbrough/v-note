<?xml version="1.0" encoding="utf-8"?>
<!-- App data never leaves the device except to the v-note server (#159).
     Android 12+ reads these rules; `allowBackup="false"` alone does not stop
     device-to-device transfer there. Every domain is excluded from both. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
