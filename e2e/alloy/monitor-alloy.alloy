// e2e stand-in for the SHARED monitoring Alloy (`monitor-alloy`) (#417).
//
// An e2e FIXTURE, not a deployed artifact. The real one is
// mini-config/monitoring-stack/config.alloy, which v-note does not own and does
// not ship. This file mirrors the parts of it the server's own telemetry goes
// through, so e2e exercises the server against the collector it is deployed
// against. Mirrored from mini-config master 984587b (mini-config PR #47):
//
//   1. the `apps` OTLP receiver (gRPC :4317, HTTP :4318) — `otelcol.receiver.otlp
//      "apps"` — with its `transform "apps"` vocabulary translation (the pusher
//      marks its own data: `telemetry_source` fills the indexed `log_source`
//      when that is absent, and `client` in either key wins in both), then
//      traces to Tempo and logs to Loki's OTLP ingest. The collector stamps NO
//      marker of its own: a pusher that sets none lands unmarked, which is why
//      the server sets `telemetry_source = "otlp"` on its resource;
//   2. the Docker log scrape, stamping `log_source = "docker"` and taking
//      `service_name` / `deployment_environment` from the container's
//      `observability.*` labels — `loki.source.docker "docker_logs"`. Narrowed
//      to this compose project's `app` container, because on a CI host the
//      socket sees every container on the machine.
//
// Not mirrored: the metrics half of the `apps` pipeline (the server does not
// push metrics, #417 deviation 1) and everything unrelated to v-note.
//
// MIRROR DRIFT IS THE RISK. Nothing checks this file against config.alloy. A
// green e2e run proves the *server* exports correct OTLP to a collector of this
// shape; it does not prove the shared Alloy still has that shape. Dev is the
// proof of that. When config.alloy changes the `apps` pipeline or the Docker
// scrape, change this file in the same breath.
//
// Endpoints are the e2e service names (`tempo`, `loki`), where config.alloy
// names `monitor-tempo` and `loki` on proxy-backend.

// ---------------------------------------------------------------------------
// OTLP from applications — config.alloy `otelcol.receiver.otlp "apps"`
// ---------------------------------------------------------------------------

otelcol.receiver.otlp "apps" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.processor.transform.apps.input]
		logs   = [otelcol.processor.transform.apps.input]
	}
}

// Verbatim from config.alloy (traces and logs; its metric statements are not
// mirrored, see above).
otelcol.processor.transform "apps" {
	error_mode = "ignore"

	trace_statements {
		context    = "resource"
		statements = [
			`set(attributes["log_source"], "client") where attributes["telemetry_source"] == "client"`,
			`set(attributes["telemetry_source"], "client") where attributes["log_source"] == "client"`,
			`set(attributes["log_source"], attributes["telemetry_source"]) where attributes["log_source"] == nil and attributes["telemetry_source"] != nil`,
			`set(attributes["deployment.environment"], attributes["deployment.environment.name"]) where attributes["deployment.environment.name"] != nil`,
		]
	}

	log_statements {
		context    = "resource"
		statements = [
			`set(attributes["log_source"], "client") where attributes["telemetry_source"] == "client"`,
			`set(attributes["telemetry_source"], "client") where attributes["log_source"] == "client"`,
			`set(attributes["log_source"], attributes["telemetry_source"]) where attributes["log_source"] == nil and attributes["telemetry_source"] != nil`,
			`set(attributes["deployment.environment"], attributes["deployment.environment.name"]) where attributes["deployment.environment.name"] != nil`,
		]
	}

	output {
		traces = [otelcol.processor.batch.apps.input]
		logs   = [otelcol.processor.batch.apps.input]
	}
}

otelcol.processor.batch "apps" {
	output {
		traces = [otelcol.exporter.otlp.tempo.input]
		logs   = [otelcol.exporter.otlphttp.loki.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		tls {
			insecure = true
		}
	}
}

// Loki's native OTLP ingest. A base URL: the exporter appends /v1/logs.
otelcol.exporter.otlphttp "loki" {
	client {
		endpoint = "http://loki:3100/otlp"

		tls {
			insecure = true
		}
	}
}

// ---------------------------------------------------------------------------
// Docker log scrape — config.alloy `loki.source.docker "docker_logs"`
// ---------------------------------------------------------------------------

discovery.docker "app" {
	host = "unix:///var/run/docker.sock"

	// Both labels must match (Docker ANDs label filters): this project's `app`.
	filter {
		name   = "label"
		values = [
			string.format("com.docker.compose.project=%s", sys.env("E2E_COMPOSE_PROJECT")),
			"com.docker.compose.service=app",
		]
	}
}

discovery.relabel "app_logs" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "^/?(.*)$"
		target_label  = "service_name"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "^/?(.*)$"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "(.+)"
		target_label  = "compose_service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_observability_service_name"]
		regex         = "(.+)"
		target_label  = "service_name"
	}

	rule {
		source_labels = ["__meta_docker_container_label_observability_deployment_environment"]
		regex         = "(.+)"
		target_label  = "deployment_environment"
	}
}

loki.source.docker "app_logs" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.app.targets
	labels        = {"log_source" = "docker"}
	relabel_rules = discovery.relabel.app_logs.rules
	forward_to    = [loki.write.loki.receiver]
}

loki.write "loki" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
