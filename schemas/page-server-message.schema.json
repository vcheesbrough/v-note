{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v-note/schemas/page-server-message.schema.json",
  "title": "PageServerMessage",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "session_id", "last_seq"],
      "properties": {
        "type": { "const": "welcome" },
        "session_id": { "type": "string", "minLength": 1 },
        "last_seq": { "type": "integer", "minimum": 0 },
        "lease_holder": { "type": "string", "minLength": 1 },
        "paper": { "enum": ["none", "ruled-margin-narrow", "ruled-margin-wide", "ruled-narrow", "ruled-wide", "squared-small", "squared-large"], "default": "none" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "seq", "client_batch_id", "strokes"],
      "properties": {
        "type": { "const": "stroke-batch" },
        "seq": { "type": "integer", "minimum": 0 },
        "client_batch_id": { "type": "string", "minLength": 1 },
        "strokes": {
          "type": "array",
          "items": { "$ref": "stroke.schema.json" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "page_id", "last_seq", "batches", "tombstones"],
      "properties": {
        "type": { "const": "page-replay" },
        "page_id": { "type": "string", "minLength": 1 },
        "last_seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Head seq the subscriber is caught up to; this frame subsumes `synced`."
        },
        "batches": {
          "type": "array",
          "items": { "$ref": "stroke-batch.schema.json" },
          "description": "Surviving stroke batches in seq order, with delete-wins already applied."
        },
        "tombstones": {
          "type": "array",
          "items": { "$ref": "tombstone-batch.schema.json" },
          "description": "Every tombstone batch on the page, replayed even when from_seq skips the batches they deleted from."
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "revision", "client_mutation_id", "stroke_ids"],
      "properties": {
        "type": { "const": "tombstone-batch" },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Per-page monotonic tombstone revision assigned by the server."
        },
        "client_mutation_id": {
          "type": "string",
          "minLength": 1,
          "description": "Idempotency key of the commit-tombstones that produced it."
        },
        "stroke_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Ids of the erased strokes; delete wins over any later replay of the same ids."
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "last_seq"],
      "properties": {
        "type": { "const": "synced" },
        "last_seq": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "lease-granted" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "holder"],
      "properties": {
        "type": { "const": "lease-denied" },
        "holder": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "lease-changed" },
        "holder": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code", "message"],
      "properties": {
        "type": { "const": "error" },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "client_mutation_id": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "paper", "revision"],
      "properties": {
        "type": { "const": "paper-changed" },
        "paper": { "enum": ["none", "ruled-margin-narrow", "ruled-margin-wide", "ruled-narrow", "ruled-wide", "squared-small", "squared-large"] },
        "revision": { "type": "integer", "minimum": 0 }
      }
    }
  ]
}
