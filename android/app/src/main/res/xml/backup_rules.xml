<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below (#159): backup is already off (`allowBackup="false"`);
     these rules exclude everything too, so a device that honours them anyway
     backs up nothing. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
