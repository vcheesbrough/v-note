# syntax=docker/dockerfile:1.7

# CI-only: Android devDebug instrumented tests (Woodpecker android-instrumented).
# Requires --privileged and /dev/kvm on the Woodpecker agent.
# Emulator + system image are baked here so runtime does not re-download SDK packages.
# Base image pin: scripts/android-build-box-image.ref (override via --build-arg in CI).
# Declared as name + digest rather than one ref so the `FROM` and the OCI
# `base.*` labels at the end are built from the same values; CI splits the ref
# file on `@` and passes both, so the pin still has exactly one home.
ARG BASE_IMAGE_NAME=mingc/android-build-box:master
ARG BASE_IMAGE_DIGEST=sha256:47a26138302605eb8a37b024e8a263af0812c14800813458bc674df47cc26331
FROM ${BASE_IMAGE_NAME}@${BASE_IMAGE_DIGEST}

ARG ANDROID_API_LEVEL=36
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH=/opt/android-sdk/emulator:/opt/android-sdk/platform-tools:/opt/android-sdk/cmdline-tools/latest/bin:${PATH}
ENV ANDROID_API_LEVEL=${ANDROID_API_LEVEL}
ENV AVD_NAME=vnote-ci-api-${ANDROID_API_LEVEL}
ENV SYSTEM_IMAGE=system-images;android-${ANDROID_API_LEVEL};google_apis;x86_64

RUN yes | sdkmanager --licenses >/dev/null 2>&1 || true \
    && sdkmanager "platform-tools" "emulator" "${SYSTEM_IMAGE}" \
    && echo no | avdmanager create avd -n "${AVD_NAME}" -k "${SYSTEM_IMAGE}" -d pixel_6 --force

ARG V_NOTE_RELEASE=
ENV V_NOTE_RELEASE=${V_NOTE_RELEASE}
WORKDIR /workspace
COPY . .
RUN chmod +x scripts/run-android-instrumented-ci.sh
RUN cd android \
    && chmod +x ./gradlew \
    && ./gradlew --no-daemon --console=plain -Pandroid.sdk.dir=/opt/android-sdk --version
RUN --mount=type=cache,id=v-note-gradle-user,target=/root/.gradle,sharing=locked \
    --mount=type=cache,id=v-note-gradle-project,target=/workspace/android/.gradle,sharing=locked \
    ./scripts/sync-version.sh \
    && cd android \
    && chmod +x ./gradlew \
    && ./gradlew --no-daemon --console=plain -Pandroid.sdk.dir=/opt/android-sdk \
        :app:assembleDevDebug \
        :app:assembleDevDebugAndroidTest
CMD ["bash", "scripts/run-android-instrumented-ci.sh"]

# OCI image metadata — see Dockerfile.web for the rationale.
ARG BASE_IMAGE_NAME
ARG BASE_IMAGE_DIGEST
ARG OCI_IMAGE_VERSION=
ARG OCI_IMAGE_REVISION=
ARG OCI_IMAGE_CREATED=
LABEL org.opencontainers.image.title="v-note-android-instrumented" \
      org.opencontainers.image.description="v-note Android API ${ANDROID_API_LEVEL} CI image (devDebug instrumented tests + emulator)" \
      org.opencontainers.image.licenses="PolyForm-Noncommercial-1.0.0" \
      org.opencontainers.image.url="https://github.com/vcheesbrough/v-note" \
      org.opencontainers.image.source="https://github.com/vcheesbrough/v-note" \
      org.opencontainers.image.authors="Vincent Cheesbrough" \
      org.opencontainers.image.vendor="Vincent Cheesbrough" \
      org.opencontainers.image.documentation="https://github.com/vcheesbrough/v-note/blob/master/docs/DEPLOY.md" \
      org.opencontainers.image.base.name="${BASE_IMAGE_NAME}" \
      org.opencontainers.image.base.digest="${BASE_IMAGE_DIGEST}" \
      org.opencontainers.image.version="${OCI_IMAGE_VERSION}" \
      org.opencontainers.image.revision="${OCI_IMAGE_REVISION}" \
      org.opencontainers.image.created="${OCI_IMAGE_CREATED}"
