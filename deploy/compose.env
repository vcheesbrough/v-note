# Non-secret compose configuration (committed).
# scripts/local-compose-env.sh merges this with a locally generated POSTGRES_PASSWORD
# into deploy/.env (gitignored). No secret store is involved.

V_NOTE_CONTAINER_NAME=v-note-local
V_NOTE_HOST=localhost
DB_VOLUME=v-note-local-db
V_NOTE_IMAGE_TAG=local
APP_ENV=dev

# Mock OIDC — service mock-oidc in docker-compose.local.yml (published :18080).
# Server uses internal mock-oidc:8080 for discovery/token/JWKS; browser uses localhost:18080.
OIDC_ISSUER_URL=http://mock-oidc:8080/default
OIDC_AUTHORIZE_URL=http://localhost:18080/default/authorize
OIDC_CLIENT_ID=v-note-test
OIDC_REDIRECT_URI=https://localhost:8443/auth/callback
REQUIRED_SCOPE=v-note:test:access

# Client telemetry ingest (#439) — deploy/docker-compose.yml requires these, the
# deploy step renders them from sovereign-config. Locally the ingest validates
# tokens against the same mock issuer the app does; OIDC_AUDIENCE is set from
# OIDC_CLIENT_ID by docker-compose.local.yml.
OIDC_AUDIENCE=v-note-test
ALLOWED_SERVICE_NAMES=^v-note-(spa|android)$
