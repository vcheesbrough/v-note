# deploy/.env is generated — do not copy this file as-is.
#
#   export BAO_ADDR=https://secrets.desync.link
#   export BAO_TOKEN=<read token for secret/v-note-stack/env>
#   ./scripts/fetch-compose-env.sh
#
# Non-secret defaults live in deploy/compose.env (committed).
# Secrets live in OpenBao: secret/v-note-stack/env
#   POSTGRES_PASSWORD
#   OIDC_CLIENT_SECRET
#
# Seed or rotate (operator):
#   ./scripts/patch-v-note-openbao-secrets.sh
#
# Woodpecker mini deploy uses secret/woodpecker/repos/vcheesbrough/v-note — see docs/DEPLOY.md.
