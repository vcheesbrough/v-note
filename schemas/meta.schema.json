{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v-note/schemas/meta.schema.json",
  "title": "MetaResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["app_name", "app_version", "protocol_version"],
  "properties": {
    "app_name": {
      "type": "string"
    },
    "app_version": {
      "type": "string"
    },
    "protocol_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
